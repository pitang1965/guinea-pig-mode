{
  "manifest_version": 3,
  "name": "モルモットモード / Guinea Pig Mode",
  "version": "1.0.0",
  "description": "どのサイトにも、かわいいモルモットの相棒を住まわせます。歩く、跳ねる、要素の上に乗る、ドラッグして投げられる。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "モルモットモード",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/settings.js",
        "src/content/character.js",
        "src/content/pet.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/moru.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
